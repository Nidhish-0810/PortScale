# PortScale Environment Variables
# Copy this to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────
# SQLite (default, good for local dev)
DATABASE_URL=sqlite:///./portscale.db

# ── Redis ─────────────────────────────────────────────────────────
# Used by Docker Compose automatically (no need to change)
# REDIS_URL=redis://redis:6379

# ── GitHub OAuth App ──────────────────────────────────────────────
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ── Security Secrets (generate random strings) ────────────────────
# Run: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=changeme-generate-a-secret
JWT_SECRET=changeme-generate-a-32-char-secret

# ── URLs ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# This must be accessible FROM THE BROWSER (not Docker service name)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of the control-plane API — used for GitHub webhook callbacks
# For production: set to your public domain, e.g. https://api.portscale.example.com
CONTROL_PLANE_URL=http://localhost:8000
