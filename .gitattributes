# Normalize line endings to LF in the repository
* text=auto eol=lf

# Force LF for all source files
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.txt   text eol=lf
*.env   text eol=lf
*.sh    text eol=lf

# Binary files — do not touch
*.png   binary
*.jpg   binary
*.svg   binary
*.ico   binary
